
import { NextResponse } from "next/server";
import { Resend } from "resend";

const resend = new Resend(process.env.RESEND_API_KEY);

export async function POST(req: Request) {
  try {
    const { name, email, message, serviceTitle, servicePrice } = await req.json();

    if (!name || !email) {
      return NextResponse.json(
        { error: "To onoma kai to email einai υποχρεωτικά." },
        { status: 400 }
      );
    }

    const data = await resend.emails.send({
      from: "Portfolio Contact <onboarding@resend.dev>",
      to: ["elanaspww@gmail.com"],
      replyTo: email,
      subject: `Neo Aitima Parangelias: ${serviceTitle}`,
      html: `
        <h2>Neo Aitima Parangelias</h2>
        <p><strong>Onomateponymo:</strong> ${name}</p>
        <p><strong>Email Pelati:</strong> ${email}</p>
        <p><strong>Paketo:</strong> ${serviceTitle} (${servicePrice})</p>
        <hr />
        <h3>Simeioseis / Leptomereies:</h3>
        <p>${message || "Den katachorithikan simeioseis."}</p>
      `,
    });

    return NextResponse.json({ success: true, data });
  } catch (error) {
    return NextResponse.json({ error: "Apotychia apostolis email" }, { status: 500 });
  }
}
